{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellphone.local/schemas/protocol/task-artifact.schema.json",
  "title": "WellPhone TaskArtifact",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "taskId": { "type": "string", "format": "uuid" },
    "kind": { "enum": ["itinerary", "json", "text", "image", "pdf", "map"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "contentType": { "type": "string", "minLength": 1 },
    "payload": {},
    "storageReference": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "taskId", "kind", "title", "contentType", "createdAt"]
}
