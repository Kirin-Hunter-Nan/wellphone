# 百炼 API Key。只保存在服务端，不要写入 iOS 工程。
DASHSCOPE_API_KEY=

# 填写与你的 API Key 同地域的 OpenAI 兼容地址。
# 北京示例：https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=

# 填写已在百炼开通、支持多模态输入的 Qwen 模型名称。
QWEN_MODEL=

# 可选备用。默认由 iPhone 原生 MapKit 无 token 回查地点；只有设备端
# 90 秒未返回时，worker 才会使用该 Server API token 作为降级路径。
APPLE_MAPS_TOKEN=

HOST=127.0.0.1
PORT=8787
MAX_REQUEST_BYTES=26214400
CHAT_REQUEST_LEASE_SECONDS=150
CONVERSATION_CONTEXT_MESSAGES=40
CONVERSATION_CONTEXT_CHARACTERS=32000
CONTINUATION_LEASE_SECONDS=150
TASK_WORKER_LEASE_SECONDS=300
TASK_WORKER_POLL_SECONDS=2
TASK_WORKER_MAX_ATTEMPTS=3
DATABASE_URL=postgresql://wellphone:wellphone-local-dev@127.0.0.1:5432/wellphone

# Docker Compose 的 PostgreSQL 配置。本机联调可以保留默认值；正式部署必须修改密码。
POSTGRES_DB=wellphone
POSTGRES_USER=wellphone
POSTGRES_PASSWORD=wellphone-local-dev
